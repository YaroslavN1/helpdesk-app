{
  "name": "server",
  "version": "1.0.0",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "bun --bun run prisma generate",
    "db:migrate": "bun --bun run prisma migrate dev",
    "db:push": "bun --bun run prisma db push",
    "db:studio": "bun --bun run prisma studio",
    "db:seed": "bun prisma/seed-admin.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.70",
    "@helpdesk/core": "workspace:*",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "ai": "^7.0.106",
    "better-auth": "^1.6.11",
    "cors": "^2.8.5",
    "dompurify": "^3.3.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "jsdom": "^29.1.1",
    "pg": "^8.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/helmet": "^4.0.0",
    "@types/jsdom": "^27.0.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "dotenv": "^17.4.2",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2",
    "typescript": "^5.8.0",
    "vitest": "^4.1.7"
  }
}
